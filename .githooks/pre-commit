#!/bin/sh
set -eu

if [ -x frontend/node_modules/.bin/prettier ]; then
  prettier=frontend/node_modules/.bin/prettier
elif [ -x backend/node_modules/.bin/prettier ]; then
  prettier=backend/node_modules/.bin/prettier
else
  echo "Prettier is not installed. Run npm install in frontend or backend."
  exit 1
fi

staged_files=$(mktemp)
trap 'rm -f "$staged_files"' EXIT

git diff --cached --name-only --diff-filter=ACMR -z -- \
  ':(glob)frontend/**/*.ts' \
  ':(glob)frontend/**/*.tsx' \
  ':(glob)backend/**/*.ts' \
  ':(glob)backend/**/*.tsx' \
  ':(glob)common/**/*.ts' \
  ':(glob)common/**/*.tsx' \
  > "$staged_files"

if [ -s "$staged_files" ]; then
  xargs -0 "$prettier" --write < "$staged_files"
  xargs -0 git add -- < "$staged_files"
fi
