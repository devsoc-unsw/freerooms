{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "lint": "npm run format:check && eslint .",
    "lint:fix": "prettier --write \"**/*.{ts,tsx}\" && eslint . --fix",
    "lint:colours": "node scripts/check-colours.mjs",
    "lint:tokens": "node scripts/check-design-tokens.mjs",
    "lint:design": "npm run lint:colours && npm run lint:tokens",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run lint:design && npm run typecheck && npm test -- --runInBand",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/system": "^9.4.0",
    "@mui/x-date-pickers": "^9.14.0",
    "@reduxjs/toolkit": "^2.12.0",
    "antd": "^6.6.5",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "mapbox-gl": "^3.31.0",
    "match-sorter": "^8.3.0",
    "motion": "^13.4.0",
    "next": "^16.3.5",
    "nuqs": "^2.10.1",
    "react": "^19.3.0",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^19.3.0",
    "react-map-gl": "^8.1.3",
    "react-redux": "^9.3.0",
    "sharp": "^0.35.4",
    "swiper": "^14.2.0",
    "swr": "^2.5.1",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/css-mediaquery": "^0.1.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-big-calendar": "^1.6.3",
    "css-mediaquery": "^0.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.8",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.11.0"
  }
