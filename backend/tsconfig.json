{
  "compilerOptions": {
    "target": "ES2018",
    "module": "node18",
    "moduleResolution": "node16",
    "outDir": "dist",
    "rootDir": "..", 
    "isolatedModules": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@common/*": [
        "../common/*"
      ]
    },
    "types": [
      "jest"
    ]
  },
  "include": [
    "./src/*.ts",
    "./__tests__/*.ts"
  ]
}