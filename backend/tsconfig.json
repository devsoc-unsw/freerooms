{
  "compilerOptions": {
    "target": "ES2018",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "paths": {
      "@common/*": ["../common/*"]
    },
    "types": ["jest"]
  },
  "include": ["./src/**/*.ts", "./__tests__/**/*.ts", "../common/*.ts"]
}